# ===== คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (ห้ามส่งไฟล์ .env ให้ใคร) =====

# --- OpenRouter ---
# สร้าง key ได้ที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# โมเดลเริ่มต้น (openrouter/auto = ให้ OpenRouter เลือกให้อัตโนมัติ)
DEFAULT_MODEL=openrouter/auto
# โมเดลโปรด แสดงด้านบนสุดของตัวเลือก (คั่นด้วย , ) ดูชื่อได้ที่ https://openrouter.ai/models
FAVORITE_MODELS=openrouter/auto,anthropic/claude-sonnet-4.5,openai/gpt-4o-mini,google/gemini-2.5-flash,deepseek/deepseek-chat
# System prompt เริ่มต้น
SYSTEM_PROMPT=คุณเป็นผู้ช่วย AI ของวิทยาลัย ตอบเป็นภาษาไทย กระชับ ชัดเจน

# --- Web ---
PORT=3000
# รหัสผ่านเข้าหน้าเว็บ (ตั้งให้ยาวและเดายาก)
WEB_PASSWORD=change-me-please
# ข้อความสุ่มยาว ๆ ใช้เซ็นคุกกี้ล็อกอิน (พิมพ์มั่ว ๆ อย่างน้อย 32 ตัวอักษร)
SESSION_SECRET=replace-with-a-long-random-string-xxxxxxxxxxxxxxxx

# --- Discord (เว้นว่างได้ ถ้ายังไม่ใช้ Discord) ---
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
# User ID ที่สั่งบอทได้ (คั่นด้วย , ได้หลายคน) — ว่าง = ไม่มีใครสั่งได้
DISCORD_ALLOWED_USER_IDS=
